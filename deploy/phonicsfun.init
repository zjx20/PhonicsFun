#!/bin/sh /etc/rc.common
# OpenWrt procd init 脚本
#
# 安装：
#   cp phonicsfun-linux-<arch> /opt/phonicsfun/phonicsfun
#   cp deploy/phonicsfun.init /etc/init.d/phonicsfun && chmod +x /etc/init.d/phonicsfun
#   编辑下面的 GEMINI_API_KEY，然后：
#   /etc/init.d/phonicsfun enable && /etc/init.d/phonicsfun start

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /opt/phonicsfun/phonicsfun
	procd_set_param env GEMINI_API_KEY=在这里填key DATA_DIR=/opt/phonicsfun/data PORT=8080
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
